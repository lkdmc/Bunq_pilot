# Copy this file to backend/.env and fill in your values:
# cp env.example backend/.env

ANTHROPIC_API_KEY=sk-ant-...

# bunq SDK (used by bunq_client.py — saves session to bunq.conf automatically)
BUNQ_API_KEY=sandbox_...

# bunq manual signing (used by send_transactions.py/.sh)
BUNQ_SESSION_TOKEN=your_session_token
BUNQ_USER_ID=your_user_id
BUNQ_MONETARY_ACCOUNT_ID=your_monetary_account_id
BUNQ_PRIVATE_KEY_PATH=private.pem

# Admin endpoint protection (set a strong random string)
ADMIN_SECRET=change_me_to_a_strong_secret
